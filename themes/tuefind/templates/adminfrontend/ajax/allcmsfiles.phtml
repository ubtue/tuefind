<?php
    $tuefind = $this->tuefind();
    $userType = $tuefind->getTueFindSubsystem();
    if (method_exists($this, 'ixtheo')) {
        $userType = $this->ixtheo()->getUserType();
    }
    $baseSyncPath = $this->serverPath;
    $relativePath = ltrim(str_replace($baseSyncPath, '', $this->fullPath), '/');
    $pathParts = array_filter(explode('/', $relativePath));
    $serverFolderArray = explode('/', $this->serverPath);
    $parentFullPath = dirname($this->fullPath);
    if (strlen($parentFullPath) < strlen($baseSyncPath)) {
        $parentFullPath = $baseSyncPath;
    }
    $parentTheme = ltrim(str_replace($baseSyncPath, '', $parentFullPath), '/');
    $modeType = $this->modetype;
?>

<div class="cms-sync-container">
    <!-- Breadcrumbs -->
    <div class="cms-breadcrumbs mb-3">
        <div class="cms-actions-panel-left mb-3 gap-2 text-end hideInPlugin row">
            <div class="input-group mb-3 w-50 col">
                <?php if ($tuefind->isAdmin()): ?>
                    <button type="button"
                        class="btn btn-primary"
                        id="createFolderBtn"
                        data-bs-toggle="modal"
                        data-bs-target="#createFolderModal"
                        data-theme="<?= $this->escapeHtml($parentTheme) ?>"
                        data-full-path="<?= $this->escapeHtml($parentFullPath) ?>"
                        data-server-path="<?= $this->escapeHtml($this->serverPath) ?>">
                        <i class="fas fa-folder-plus me-2"></i>Create Folder
                    </button>
                <?php endif; ?>
            </div>
            <div class="input-group mb-3 w-50 col">
                <input type="file" class="form-control form-control-lg fileUploadInput" placeholder="Add Image" aria-label="Add Image" aria-describedby="button-addon2">
                <button class="btn btn-outline-primary uploadBtn" type="button" id="button-addon2" ><?=$this->icon('upload')?></button>
            </div>
        </div>
        <div class="cms-actions-panel-right">
            <?php if (!empty($pathParts)): ?>
                <span class="btn btn-secondary tf-theme-btn me-1"
                    data-theme="<?= $this->escapeHtml($parentTheme) ?>"
                    data-full-path="<?= $this->escapeHtml($parentFullPath) ?>"
                    data-block="AJAXCMSDocsBlock"
                    data-modetype="<?= $this->escapeHtml($modeType) ?>"
                    data-server-path="<?= $this->escapeHtml($this->serverPath) ?>">
                    <i class="fas fa-arrow-left me-1"></i> ..
                </span>
            <?php endif; ?>

            <?php $accumulatedPath = '';
            foreach ($pathParts as $folder):
                $accumulatedPath .= ($accumulatedPath === '' ? '' : '/') . $folder;
                $stepFullPath = $baseSyncPath . '/' . $accumulatedPath;
                if (!in_array($folder, $serverFolderArray)) : ?>
                    <span class="btn btn-secondary tf-theme-btn me-1"
                        data-theme="<?= $this->escapeHtml($accumulatedPath) ?>"
                        data-full-path="<?= $this->escapeHtml($stepFullPath) ?>"
                        data-block="AJAXCMSDocsBlock"
                        data-modetype="<?= $this->escapeHtml($modeType) ?>"
                        data-server-path="<?= $this->escapeHtml($this->serverPath) ?>">
                        <i class="fas fa-folder text-warning me-1"></i>
                        <?= $this->escapeHtml($folder) ?>
                    </span>
                <?php endif; ?>
            <?php endforeach; ?>
        </div>
    </div>

    <div class="row mainCMSDocsBlock">
        <div class="col-md-12">
            <?php if ($this->serverPath == $this->fullPath): // if home directory ?>
                <?php if (!$tuefind->isAdmin()) {

                    foreach ($this->folders as $folder) {
                        if ($folder['name'] === $userType) {
                            $this->folders = [$folder]; // Keep only the folder that matches the user type
                        }
                    }
                } ?>
                <?php if (!empty($this->folders)): ?>
                    <div class="show-cms-files-block">
                        <?php foreach ($this->folders as $folder): ?>
                            <span class="btn btn-folder tf-theme-btn" data-theme="<?= $this->escapeHtml($folder['name']) ?>" data-full-path="<?= $this->escapeHtml($this->fullPath . '/' . $folder['name']) ?>" data-server-path="<?= $this->escapeHtml($this->serverPath) ?>" data-block="AJAXCMSDocsBlock" data-modetype="<?= $this->escapeHtml($modeType) ?>">
                                <i class="fas fa-folder me-2 text-warning"></i>
                                <span><?= $this->escapeHtml($folder['name']) ?></span>
                            </span>
                        <?php endforeach; ?>
                    </div>
                <?php endif; ?>
            <?php else:?>
                <?php if (!empty($this->folders)): ?>
                    <div class="show-cms-files-block">
                        <?php foreach ($this->folders as $folder): ?>
                            <span class="btn btn-folder tf-theme-btn" data-theme="<?= $this->escapeHtml($folder['name']) ?>" data-full-path="<?= $this->escapeHtml($this->fullPath . '/' . $folder['name']) ?>" data-server-path="<?= $this->escapeHtml($this->serverPath) ?>" data-block="AJAXCMSDocsBlock" data-modetype="<?= $this->escapeHtml($modeType) ?>">
                                <i class="fas fa-folder me-2 text-warning"></i>
                                <span><?= $this->escapeHtml($folder['name']) ?></span>
                            </span>
                        <?php endforeach; ?>
                    </div>
                <?php endif; ?>
            <?php endif; ?>
        </div>
        <p class="delimiter">&nbsp;</p>
        <div class="col-md-12">
            <?php if (!empty($this->files)): ?>
                <div class="show-cms-files-block">
                    <?php foreach ($this->files as $file): ?>
                        <?= $this->context($this)->renderInContext('adminfrontend/ajax/node.phtml', ['file' => $file, 'modetype' => $modeType ]) ?>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>
        </div>
    </div>
</div>


