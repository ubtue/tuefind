<?php
$jsSnippet = <<<EOD
    $('.check-Dspace').click(function() {
      let collection = $('.collection_name').text().trim();
      $.ajax({
        url: VuFind.path + '/AJAX/JSON?method=Admin',
        type: 'GET',
        data: {
          action: 'checkDspace',
          collection_name: collection
        },
        dataType: 'json',
        beforeSend: function() {
          $('.ajaxResult').html('<i class="fa fa-spinner fa-spin" style="font-size:24px"></i>');
        },
        success: function(response) {
          if (response && response.data && response.data.status) {
            $('.ajaxResult').html('<p class="text-success">Success! DSpace API is working properly.</p>');
          } else {
            $('.ajaxResult').html(`<p class="text-danger">Collection `+collection+` not found in DSpace API!</p>`);
          }
        },
        error: function(xhr, status, error) {
          console.error('Request error: ', error);
          $('.ajaxResult').html(`<p class="text-danger">`+error+`</p>`);
        }
      });
    });
    EOD;
?>
<?=$this->assetManager()->outputInlineScriptString($jsSnippet)?>
