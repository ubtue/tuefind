          <td>
            <?php if ($one->getCmsPage() !== null): ?>
              <?=$this->escapeHtml($one->getCmsPage()->getPageSystemId())?>
            <?php endif; ?>
          </td>
          <td>
            <?=$this->escapeHtml($one->getUser()->getUsername())?>
          </td>
          <td>
            <?=$this->escapeHtml($one->getCreated()->format('d.m.Y H:i:s'))?>
          </td>
        </tr>
      <?php endforeach; ?>
    </tbody>
  </table>
  <?=$this->assetManager()->outputInlineScriptString('TueFind.RenderDataTable();') ?>
</div>

<div class="<?=$this->layoutClass('sidebar')?>" id="myresearch-sidebar" role="navigation" aria-label="<?=$this->transEsc('account_menu_label')?>">
