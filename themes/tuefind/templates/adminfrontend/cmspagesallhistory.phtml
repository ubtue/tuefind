<?php
$this->breadcrumbs()->set($this->translate('Admins'), $this->url('adminfrontend-cmspages'))
      ->add($this->translate('CMS Pages History'), active: true);
?>

<div class="<?=$this->layoutClass('mainbody')?>">
  <h1><?=$this->transEsc('CMS pages history')?></h1>
  <?=$this->flashmessages()?>

  <table class="table dataTable table-striped content-list custom-link-list" data-order='[[3, "desc"]]'>
    <thead>
      <tr>
        <th><?=$this->transEsc('Comment')?></th>
        <th><?=$this->transEsc('CMS page')?></th>
        <th><?=$this->transEsc('User Name')?></th>
        <th><?=$this->transEsc('Updated')?></th>
      </tr>
    </thead>
    <tbody>
      <?php foreach ($this->CMSPagesHistory as $one): ?>
