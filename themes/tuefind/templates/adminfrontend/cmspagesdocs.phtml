                    <i class="fas fa-arrow-left me-1"></i> ..
                </a>
            <?php endif; ?>

            <?php $accumulatedPath = '';
            foreach ($pathParts as $folder):
                $accumulatedPath .= ($accumulatedPath === '' ? '' : '/') . $folder;
                $stepFullPath = '/' . $this->onlyRouteName . '/' . $accumulatedPath;
                if (!in_array($folder, $serverFolderArray)) : ?>
                   <?php if ($currentFolder === $folder): ?>
                    <span class="btn tf-theme-btn-current me-1">
                        <i class="fas fa-folder text-warning me-1"></i>
                        <?= $this->escapeHtml($folder) ?>
                    </span>
                   <?php else: ?>
                    <a href="<?= $this->escapeHtml($stepFullPath) ?>" class="btn btn-secondary tf-theme-btn me-1">
                        <i class="fas fa-folder text-warning me-1"></i>
                        <?= $this->escapeHtml($folder) ?>
                    </a>
                   <?php endif; ?>
                <?php endif; ?>
            <?php endforeach; ?>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <?php if (!empty($this->folders)): ?>
                <div class="show-cms-files-block">
