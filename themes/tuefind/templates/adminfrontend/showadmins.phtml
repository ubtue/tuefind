<?php
$jsSnippet = <<<EOD
      let timer = null;

      $('.searchUsers').on('keyup', function() {
        clearTimeout(timer);
        
        const query = $(this).val();

        if (query.trim() === '') {
          $('.ajaxResult').html('');
          return;
        }

        timer = setTimeout(function() {
          $.ajax({
           url: VuFind.path + '/AJAX/JSON?method=Admin',
            type: 'GET',
            data: { 
                    action: 'searchUsers',
                    q: query
            },
            dataType: 'json',
            success: function(response) {
              $('.ajaxResult').html(response.data);
            },
            error: function(xhr, status, error) {
              console.error('Request error: ', error);
            }
          });
        }, 300);
      });  
    EOD;
?>
<?=$this->assetManager()->outputInlineScriptString($jsSnippet)?>
